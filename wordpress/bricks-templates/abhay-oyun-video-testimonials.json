-embed-image-overlay::after {\n  content: '' !important;\n  position: absolute !important;\n  inset: 0 !important;\n  background: linear-gradient(to top, rgba(10,12,18,0.7) 0%, transparent 50%) !important;\n  pointer-events: none !important;\n}\n\n/* Simpler Golden Play Button */\nselector .elementor-widget-video .elementor-custom-embed-play {\n  background: rgba(212,168,83,0.9) !important;\n  width: 52px !important;\n  height: 52px !important;\n  border-radius: 50% !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  box-shadow: 0 6px 20px rgba(212,168,83,0.25) !important;\n  transition: transform 0.3s ease, background 0.3s ease !important;\n  z-index: 2 !important;\n}\nselector .elementor-widget-video .elementor-custom-embed-play i,\nselector .elementor-widget-video .elementor-custom-embed-play svg {\n  color: #0a0c12 !important;\n  fill: #0a0c12 !important;\n  font-size: 18px !important;\n  width: 18px !important;\n  height: 18px !important;\n  margin-left: 2px !important;\n}\nselector .ao-vid-col:hover .elementor-widget-video .elementor-custom-embed-play {\n  transform: scale(1.1) !important;\n  background: #d4a853 !important;\n}\n"
