              "settings": {
                "editor": "<div style=\"position:relative;\">\n  <div style=\"background:#0d1117;border-radius:32px;overflow:hidden;padding:56px;color:#fff;\">\n    <div style=\"font-size:80px;line-height:1;font-family:'Playfair Display',serif;color:#d4a853;margin-bottom:24px;opacity:0.6;\">\u201c</div>\n    <p style=\"font-family:'Playfair Display',serif;font-size:26px;line-height:1.5;color:#fff;margin:0 0 32px;font-weight:400;font-style:italic;\">When you reconnect with wild&nbsp;nature, trauma doesn\u2019t just heal &mdash; it transforms into&nbsp;power.</p>\n    <div style=\"font-family:'Inter',sans-serif;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#d4a853;\">— Shaman Abhay Oyun</div>\n  </div>\n\n  <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px;\">\n    <div style=\"background:#fff;border-radius:20px;padding:32px;border:1px solid rgba(13,17,23,0.05);\">\n      <div style=\"font-family:'Playfair Display',serif;font-size:48px;color:#0d1117;font-weight:400;line-height:1;\">40<span style=\"color:#d4a853\">+</span></div>\n      <div style=\"font-family:'Inter',sans-serif;font-size:13px;color:rgba(13,17,23,0.5);margin-top:8px;\">Countries of <br>active healing</div>\n    </div>\n    <div style=\"background:#fff;border-radius:20px;padding:32px;border:1px solid rgba(13,17,23,0.05);\">\n      <div style=\"font-family:'Playfair Display',serif;font-size:48px;color:#0d1117;font-weight:400;line-height:1;\">35<span style=\"color:#d4a853\">yr</span></div>\n      <div style=\"font-family:'Inter',sans-serif;font-size:13px;color:rgba(13,17,23,0.5);margin-top:8px;\">Of Shamanic <br>Mastery</div>\n    </div>\n  </div>\n</div>",
